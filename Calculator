# Function of Addition
def add(x, y):
    return x + y

# Function of Subtraction
def subtract(x, y):
    return x - y

# Function of Multiply
def multiply(x, y):
    return x * y

# Function of Devidation
def divide(x, y):
    if y == 0:
        return "Error! Not Devided by Zero"
    return x / y

# Main Program (Main Logic)
print("--- Python Calculator ---")
print("1. Addition (+)")
print("2. Subtract (-)")
print("3. Multiple (*)")
print("4. Devide (/)")

# Take Input by User
choice = input("enter your choice (1/2/3/4): ")

num1 = float(input("enter the first number: "))
num2 = float(input("enter the second number: "))

# call function acording to conditions
if choice == '1':
    print(f"output: {num1} + {num2} = {add(num1, num2)}")
elif choice == '2':
    print(f"output: {num1} - {num2} = {subtract(num1, num2)}")
elif choice == '3':
    print(f"output: {num1} * {num2} = {multiply(num1, num2)}")
elif choice == '4':
    print(f"output: {num1} / {num2} = {divide(num1, num2)}")
else:
    print("Please Choose  1, 2, 3 or 4 Only ")
